.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / WebStorm / Eclipse
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.launch
*.factorypath

# Eclipse
.metadata
.recommenders
*.prefs

